# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1
FRONTEND_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/agency-os
MONGODB_URI_TEST=mongodb://localhost:27017/agency-os-test

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-here
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Platform JWT (separate secrets for platform admin layer — REQUIRED in production)
PLATFORM_JWT_ACCESS_SECRET=your-platform-access-secret-min-32-chars-here
PLATFORM_JWT_REFRESH_SECRET=your-platform-refresh-secret-min-32-chars-here

# AWS S3 / Cloudflare R2
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=agency-os-files
# For Cloudflare R2 (optional, overrides S3)
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=agency-os-files

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Email (AWS SES or SMTP)
EMAIL_FROM=noreply@agencyos.com
EMAIL_FROM_NAME=Agency OS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# AWS SES
SES_REGION=us-east-1

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Encryption
ENCRYPTION_KEY=your-32-char-encryption-key-here!

# Magic Link
MAGIC_LINK_EXPIRY=72h
MAGIC_LINK_BASE_URL=http://localhost:5173/auth/magic

# File Upload
MAX_FILE_SIZE_BYTES=2147483648
VIRUS_SCAN_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Bull Queue
BULL_REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200

# Session
SESSION_SECRET=your-session-secret-here
COOKIE_DOMAIN=localhost

# CDN
CDN_URL=https://cdn.agencyos.com

# App
AGENCY_NAME=Agency OS
AGENCY_EMAIL=hello@agencyos.com
AGENCY_LOGO_URL=https://agencyos.com/logo.png
